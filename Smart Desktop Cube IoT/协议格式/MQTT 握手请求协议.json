{
  "device_id": string,          // 设备ID（MAC地址）
  "timestamp": int,             // 时间戳
  "type": string,               // 消息类型：handshake
  "chip_model": string,         // 芯片型号：ESP32-S3
  "version": string             // 固件版本号
}
type：
handshake         = 设备握手请求
handshake_ack     = 握手响应
data_report       = 传感器数据上报
data_report_ack   = 数据上报响应
heartbeat         = 设备心跳包
heartbeat_ack     = 服务器心跳响应
version_check     = 设备请求版本检查
ota_update        = 服务器推送OTA更新（含code判断）
control           = 服务器下发控制指令
control_ack       = 设备控制指令回执
ota_status        = 设备OTA状态上报