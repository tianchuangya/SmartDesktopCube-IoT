// ==================== 敏感配置示例 ====================
// 复制此文件为 secrets.h，填入你自己的值
// cp secrets.h.example secrets.h

#ifndef SECRETS_H
#define SECRETS_H

// WiFi 默认凭据
#define WIFI_DEFAULT_SSID  "your_ssid"
#define WIFI_DEFAULT_PWD   "your_password"

// Blinker 设备 Auth Key（在 blinker 控制台获取）
#define BLINKER_AUTH_KEY   "your_blinker_auth_key"

#endif
